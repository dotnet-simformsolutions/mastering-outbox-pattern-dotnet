{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Outbox": {
    "Publisher": "AzureServiceBus",
    "QueueName": "orders",
    "BatchSize": 50,
    "MaxRetries": 10,
    "LeaseSeconds": 30,
    "PollingInterval": "00:00:02",
    "BaseDelay": "00:00:02",
    "MaxDelay": "00:05:00",
    "Fake": {
      "FailFirstNAttempts": 0,
      "SimulateCrashAfterPublish": false
    }
  }
}
