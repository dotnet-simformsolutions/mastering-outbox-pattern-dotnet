# Copy to .env (git-ignored) and replace the placeholders. Never commit real values.

# SQL Server container (docker compose). Must meet SQL Server password complexity rules.
MSSQL_SA_PASSWORD=<your-strong-password>

# Connection strings read by the apps (ASP.NET Core / Generic Host env var syntax).
# Export these in your shell; .env is only read by docker compose.
ConnectionStrings__OrdersDb=Server=localhost,1433;Database=OutboxOrders;User Id=sa;Password=<your-strong-password>;TrustServerCertificate=True
ConnectionStrings__InventoryDb=Server=localhost,1433;Database=OutboxInventory;User Id=sa;Password=<your-strong-password>;TrustServerCertificate=True

# Real Azure Service Bus mode only (prefer dotnet user-secrets).
Outbox__Publisher=AzureServiceBus
Outbox__QueueName=orders
ConnectionStrings__ServiceBus=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key-name>;SharedAccessKey=<key>
